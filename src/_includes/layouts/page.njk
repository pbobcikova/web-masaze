---
layout: layouts/base.njk
---
{% include "partials/banner.njk" %}
<section class="section">
  <div class="wrap prose">
    {%- if heading %}
    <p class="eyebrow">{{ site.eyebrow }}</p>
    <h2>{{ heading }}</h2>
    {%- endif %}
    {%- if lead %}
    <p class="prose__lead">{{ lead }}</p>
    {%- endif %}
    {{ content | safe }}
  </div>
</section>
{%- if showCta %}
{% include "partials/cta.njk" %}
{%- endif %}
