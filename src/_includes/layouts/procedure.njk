---
layout: layouts/base.njk
---
{% from "partials/icons.njk" import icon %}
{% include "partials/banner.njk" %}

<section class="section">
  <div class="wrap procedure">
    <div class="procedure__main prose">
      <p class="eyebrow">{{ site.eyebrow }}</p>
      <h2>{{ heading or ("Jak probíhá " + ((navTitle or title) | lower) + "?") }}</h2>
      {%- if lead %}
      <p class="prose__lead">{{ lead }}</p>
      {%- endif %}
      {{ content | safe }}

      {%- if benefits and benefits.length %}
      <h3>Přínosy</h3>
      <ul class="ticks">
        {%- for item in benefits %}
        <li>{{ icon("check", 18) }}<span>{{ item }}</span></li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </div>

    <aside class="procedure__aside" aria-label="Doplňující informace">
      <div class="media" aria-hidden="true"{% if site.images.procedure %} style="--bg-image:url('{{ site.images.procedure }}')"{% endif %}></div>

      {%- if repeat %}
      
      {%- endif %}

      {%- if contraindications and contraindications.length %}
      <div class="note note--warn">
        <h3 class="note__title">Kdy masáž nevhodná</h3>
        <ul>
          {%- for item in contraindications %}
          <li>{{ item }}</li>
          {%- endfor %}
        </ul>
        <p>V případě pochybností se předem poraďte s lékařem.</p>
      </div>
      {%- endif %}

      <a class="btn" href="tel:{{ site.phone | telHref }}">Objednat se</a>
    </aside>
  </div>
</section>

{% include "partials/stats.njk" %}
{% include "partials/cta.njk" %}
