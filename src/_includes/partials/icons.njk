{# Feather-style line icons (MIT). Import the icon macro and call it with a name and size. #}
{% macro icon(name, size=24) -%}
{%- set filled = (name == "lotus") -%}
<svg class="icon icon--{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="{{ '0 0 32 32' if filled else '0 0 24 24' }}" fill="{{ 'currentColor' if filled else 'none' }}" stroke="{{ 'none' if filled else 'currentColor' }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if name == "lotus" -%}
<path d="M16 3c4.2 4 5.4 9.6 0 17-5.4-7.4-4.2-13 0-17z"/><path d="M15 21C9 21 4.5 17.5 3 12c5.5 0 9.8 3.2 12 9z"/><path d="M17 21c6 0 10.5-3.5 12-9-5.5 0-9.8 3.2-12 9z"/>
{%- elif name == "heart" -%}
<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
{%- elif name == "sun" -%}
<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
{%- elif name == "wind" -%}
<path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/>
{%- elif name == "clock" -%}
<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
{%- elif name == "phone" -%}
<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
{%- elif name == "mail" -%}
<path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><polyline points="22 6 12 13 2 6"/>
{%- elif name == "pin" -%}
<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
{%- elif name == "check" -%}
<polyline points="20 6 9 17 4 12"/>
{%- endif -%}
</svg>
{%- endmacro %}
